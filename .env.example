# Application rate caps (see src/job_apply_kit/caps.py). Both are
# required -- there is no default, and zero is rejected as a config
# error rather than treated as "no applications". Copy this file to
# .env and set real values before running anything that applies caps.

JOB_APPLY_DAILY_CAP=10
JOB_APPLY_PER_COMPANY_CAP=1

# IANA timezone the daily cap's day boundary is measured in. Optional --
# defaults to UTC if unset.
JOB_APPLY_TZ=UTC
